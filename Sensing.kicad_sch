		)
		(uuid "29680720-86af-46c7-9978-032a4512008a")
	)
	(text_box "By using 4m ohm shunts, the equation I_RES =  40*10^-6/R_SHUNT = 40*10^-6/0.004 = 0.01 A = 10mA\n\nFor the cutoff frequency of the RC filter, the equation is f_c = 1/(2*pi*R*C) = 1/(2*pi*10*1*10^-6) = 16kHz"
		(exclude_from_sim no)
		(at 154.94 22.86 0)
		(size 45.72 17.78)
		(margins 0.9525 0.9525 0.9525 0.9525)
