			)
			(justify left top)
		)
		(uuid "75e85544-9abe-4a5e-a59e-218e18006d2a")
	)
	(text_box "Some GND notes:\nPGND (Pins 23,24): Power ground pins. These pins should\nbe connected to a copper pour that forms the return for\nthe V OUT bypass capacitor on the top layer of the printed\ncircuit board.\n\nAGND (Exposed PAD, Pin 29): Analog ground pin. This\nis the ground pin used to return all of the analog circuitry\ninside the LTC4162 and should be connected to an analog\nground pour that is common with PGND (pins 23 and 24).\nIt should also be connected to a ground plane on layer 2\nof the PCB to which all of the analog components return\nsuch as the R T resistor and the INTVCC and VCC2P5 by-\npass capacitors."
		(exclude_from_sim no)
		(at 115.57 165.1 0)
		(size 60.96 33.02)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type color)
			(color 158 218 255 1)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "7e48b39a-bc3a-4a2a-87cf-5443523103f1")
	)
	(text_box "If molex is used, wire will need to be twisted for noise, and a cap will need to be placed next to ntc pin\n"
		(exclude_from_sim no)
		(at 259.08 88.9 0)
		(size 21.59 13.97)
		(margins 0.9525 0.9525 0.9525 0.9525)
