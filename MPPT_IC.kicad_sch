			)
			(justify left top)
		)
		(uuid "74407633-1b46-4334-98b2-71ec23c977ba")
	)
	(text_box "Right now I have a signal for when something has gone wrong to the MCU but nothing the MCU can do about that, Need to fix that"
		(exclude_from_sim no)
		(at 255.27 114.3 0)
		(size 25.4 17.78)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
